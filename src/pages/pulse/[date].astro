---
import type { GetStaticPaths } from 'astro';
import Layout from '@/layouts/Layout.astro';
import { url, formatDate } from '@/lib/url';
import { getAllPulseDates, getPulseEdition } from '@/services/pulse';
import { getJobsPostedOnDate } from '@/services/jobs';
import { getCompanyBySlug } from '@/services/companies';

import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import DemoBadge from '@/components/ui/DemoBadge.astro';
import CountryBadge from '@/components/ui/CountryBadge.astro';
import CompanyMonogram from '@/components/ui/CompanyMonogram.astro';

export const getStaticPaths = (async () => {
  const dates = await getAllPulseDates();
  return dates.map((date) => ({
    params: { date },
  }));
}) satisfies GetStaticPaths;

const { date } = Astro.params;
const pulse = await getPulseEdition(date);

if (!pulse) {
  return Astro.redirect(url('/404/'));
}

const jobsToday = await getJobsPostedOnDate(pulse.date);

// Resolve companies to watch
const companiesToWatch = await Promise.all(
  pulse.sideRail.companiesToWatch.map(async (slug) => {
    const comp = await getCompanyBySlug(slug);
    return comp || { slug, name: slug.toUpperCase(), hqCity: 'Europe', country: 'france', founded: 2000 };
  })
);

const trendIcons = {
  up: { symbol: '↑', color: 'text-trend-up' },
  down: { symbol: '↓', color: 'text-trend-down' },
  stable: { symbol: '→', color: 'text-muted' },
};
---

<Layout
  title={`Europe Business Pulse — Edition #${pulse.editionNumber} (${formatDate(pulse.date)})`}
  description={pulse.leadSummary}
  noindex={pulse.isDemo}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      items={[
        { label: 'Pulse', href: '/pulse/' },
        { label: formatDate(pulse.date) },
      ]}
    />

    {/* Broadhead Masthead */}
    <header class="border-b-2 border-ink pb-6 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2 font-mono text-xs text-muted">
        <div>EUROPE BUSINESS PULSE · INTELLIGENCE BRIEFING</div>
        <div class="flex items-center gap-3 tabular-nums">
          <span>EDITION #{pulse.editionNumber}</span>
          <span>·</span>
          <span>{formatDate(pulse.date)}</span>
          {pulse.isDemo && <DemoBadge type="pulse" />}
        </div>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-ink leading-tight">
        European Industrial &amp; Career Briefing
      </h1>

      <p class="mt-4 font-serif text-lg sm:text-xl text-ink/90 italic leading-relaxed border-l-2 border-amber pl-4 py-1">
        "{pulse.leadSummary}"
      </p>
    </header>

    {/* Two-Column Broadsheet Layout */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Main Column: Country Briefs (8 cols) -->
      <div class="lg:col-span-8 space-y-8">
        <SectionHeader
          kicker="Continental Dispatches"
          title="Country Intelligence Briefs"
          description="Synthesized market activity across the five core European economic hubs."
        />

        <div class="space-y-6">
          {
            pulse.countryBriefs.map((cb) => (
              <article class="bg-surface border border-hairline rounded-md p-6 hover:border-cobalt transition-colors">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-hairline">
                  <div class="flex items-center gap-3">
                    <CountryBadge iso2={cb.countryIso2} slug={cb.countrySlug} name={cb.countryName} size="md" />
                    <span class="font-serif text-xl font-bold text-ink">
                      {cb.countryName}
                    </span>
                  </div>
                  <a
                    href={url(`/countries/${cb.countrySlug}/`)}
                    class="font-mono text-xs text-cobalt hover:underline font-semibold"
                  >
                    View Country Hub →
                  </a>
                </div>

                <div class="space-y-3">
                  {cb.items.map((item, idx) => (
                    <div class="flex items-start gap-3 text-sm font-sans text-ink leading-relaxed">
                      <span class="font-mono text-xs font-bold text-muted tabular-nums shrink-0 mt-0.5">
                        0{idx + 1}.
                      </span>
                      <div>
                        <span class="font-mono text-[11px] uppercase font-bold text-cobalt mr-1.5">
                          <a href={url(`/industries/${item.industrySlug}/`)} class="hover:underline">
                            [{item.industryName}]
                          </a>
                        </span>
                        {item.text}
                        {item.companySlug && (
                          <span class="ml-1.5">
                            <a
                              href={url(`/companies/${item.companySlug}/`)}
                              class="font-mono text-xs text-ink underline font-semibold hover:text-cobalt"
                            >
                              ({item.companySlug.toUpperCase()})
                            </a>
                          </span>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Side Rail Column (4 cols) -->
      <aside class="lg:col-span-4 space-y-6">
        <!-- Companies to Watch -->
        <div class="bg-surface border border-hairline rounded-md p-5 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-hairline">
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-ink">
              Companies to Watch
            </h3>
            <a href={url('/companies/')} class="font-mono text-[11px] text-cobalt hover:underline">
              All →
            </a>
          </div>

          <div class="space-y-2.5">
            {
              companiesToWatch.map((comp) => (
                <a
                  href={url(`/companies/${comp.slug}/`)}
                  class="flex items-center justify-between p-2 rounded hover:bg-paper transition-colors group"
                >
                  <div class="flex items-center gap-2.5 truncate">
                    <CompanyMonogram name={comp.name} size="sm" />
                    <span class="text-xs font-semibold text-ink group-hover:text-cobalt truncate">
                      {comp.name}
                    </span>
                  </div>
                  <CountryBadge
                    iso2={comp.country?.slice(0, 2).toUpperCase() || 'EU'}
                    slug={comp.country}
                    size="sm"
                    linkable={false}
                  />
                </a>
              ))
            }
          </div>
        </div>

        <!-- Industries to Watch with Trend Arrows -->
        <div class="bg-surface border border-hairline rounded-md p-5 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-hairline">
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-ink">
              Industries to Watch
            </h3>
            <a href={url('/industries/')} class="font-mono text-[11px] text-cobalt hover:underline">
              All →
            </a>
          </div>

          <div class="space-y-3">
            {
              pulse.sideRail.industriesToWatch.map((ind) => {
                const icon = trendIcons[ind.trend];
                return (
                  <div class="p-2 rounded bg-paper border border-hairline">
                    <div class="flex items-center justify-between mb-1">
                      <a
                        href={url(`/industries/${ind.slug}/`)}
                        class="text-xs font-bold text-ink hover:text-cobalt underline"
                      >
                        {ind.name}
                      </a>
                      <span class={`font-mono text-sm font-bold ${icon.color}`}>
                        {icon.symbol} {ind.trend.toUpperCase()}
                      </span>
                    </div>
                    <p class="text-[11px] text-muted font-sans leading-tight">
                      {ind.note}
                    </p>
                  </div>
                );
              })
            }
          </div>
        </div>

        <!-- Hiring Today Computed Panel -->
        <div class="bg-surface border border-hairline rounded-md p-5 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-hairline">
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-ink">
              Hiring Today
            </h3>
            <span class="font-mono text-xs font-bold text-cobalt tabular-nums">
              {jobsToday.length} Listings
            </span>
          </div>

          <p class="text-xs text-muted font-sans leading-relaxed">
            Derived directly from jobs posted on {formatDate(pulse.date)}.
          </p>

          <div class="space-y-2">
            {
              jobsToday.slice(0, 4).map((j) => (
                <a
                  href={url(`/jobs/${j.slug}/`)}
                  class="block p-2 rounded hover:bg-paper transition-colors group"
                >
                  <div class="text-xs font-semibold text-ink group-hover:text-cobalt truncate">
                    {j.title}
                  </div>
                  <div class="font-mono text-[10px] text-muted">
                    {j.company.toUpperCase()} · [{j.country.slice(0, 2).toUpperCase()}] · {j.employmentType}
                  </div>
                </a>
              ))
            }
          </div>

          <a
            href={url('/jobs/')}
            class="block w-full py-2 text-center rounded border border-hairline bg-paper text-ink font-mono text-xs font-semibold uppercase hover:border-cobalt transition-colors"
          >
            Browse All {jobsToday.length} Jobs →
          </a>
        </div>

        <!-- Career Insight of the Day -->
        <div class="bg-paper border-2 border-amber/40 rounded-md p-5 space-y-2">
          <span class="block font-mono text-[10px] font-bold uppercase tracking-widest text-amber">
            Career Insight of the Day
          </span>
          <h4 class="font-serif text-base font-bold text-ink leading-tight">
            {pulse.sideRail.careerInsightOfDay.title}
          </h4>
          <p class="text-xs text-ink/80 font-sans leading-relaxed">
            {pulse.sideRail.careerInsightOfDay.content}
          </p>
          {pulse.sideRail.careerInsightOfDay.linkedRoleSlug && (
            <div class="pt-2">
              <a
                href={url(`/careers/roles/${pulse.sideRail.careerInsightOfDay.linkedRoleSlug}/`)}
                class="font-mono text-xs font-semibold text-cobalt hover:underline inline-flex items-center gap-1"
              >
                <span>Role: {pulse.sideRail.careerInsightOfDay.linkedRoleName}</span>
                <span>→</span>
              </a>
            </div>
          )}
        </div>

        <!-- Startup Funding Watch -->
        <div class="bg-surface border border-hairline rounded-md p-5 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-hairline">
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-ink">
              Startup Funding Watch
            </h3>
            <span class="font-mono text-[10px] text-muted uppercase">Sample Rounds</span>
          </div>

          <div class="space-y-2.5">
            {
              pulse.sideRail.startupFundingWatch.map((item) => (
                <div class="p-2 rounded bg-paper border border-hairline flex items-center justify-between">
                  <div>
                    <div class="text-xs font-semibold text-ink">
                      {item.name}
                    </div>
                    <div class="font-mono text-[10px] text-muted">
                      {item.round} · [{item.countryIso2}]
                    </div>
                  </div>
                  <div class="font-mono text-xs font-bold text-cobalt tabular-nums">
                    {item.amount}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>
