---
import Layout from '@/layouts/Layout.astro';
import { url } from '@/lib/url';
import { getLabEntries } from '@/services/lab';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';

const entries = await getLabEntries();
---

<Layout
  title="My Lab — Personal Research, Projects & Engineering Experiments"
  description="The owner's personal engineering laboratory, platform architecture notes, experiments, and technical roadmap."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12 text-ink font-sans">
    <Breadcrumbs items={[{ label: 'My Lab' }]} />

    <header class="border-b border-hairline pb-8 space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded border border-hairline bg-surface text-ink font-mono text-xs font-semibold uppercase tracking-wider">
        <span>Owner Engineering Lab &amp; Learning Workspace</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-ink">
        My Lab
      </h1>

      <p class="text-base sm:text-lg text-muted max-w-2xl font-sans leading-relaxed">
        The public development lab and technical sketchbook for EuroPulse. A living portfolio of architecture choices, static platform experiments, and data pipelines.
      </p>
    </header>

    <!-- Lab Entries Section -->
    <section class="space-y-6">
      <SectionHeader
        kicker="Work in Progress &amp; Research"
        title="Projects &amp; Experiments"
        description="Every Markdown document in src/data/lab/ renders as a dedicated report. Drafts are omitted in production."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          entries.map((entry) => (
            <article class="bg-surface border border-hairline rounded-md p-6 hover:border-cobalt transition-colors flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2 font-mono text-xs text-muted">
                  <span class="font-bold text-cobalt uppercase">{entry.type}</span>
                  <span class="px-2 py-0.5 rounded bg-paper border border-hairline text-ink font-semibold">
                    {entry.status}
                  </span>
                </div>

                <h3 class="font-serif text-xl font-bold text-ink group-hover:text-cobalt transition-colors mb-2">
                  <a href={url(`/my-lab/${entry.slug}/`)} class="hover:underline">
                    {entry.title}
                  </a>
                </h3>

                <p class="text-xs text-muted font-sans leading-relaxed mb-4">
                  {entry.summary}
                </p>

                <div class="flex flex-wrap gap-1.5 mb-4">
                  {entry.tags.map((tag) => (
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-paper border border-hairline text-muted">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <div class="pt-3 border-t border-hairline flex items-center justify-between font-mono text-xs">
                <span class="text-muted">{entry.date}</span>
                <a
                  href={url(`/my-lab/${entry.slug}/`)}
                  class="text-cobalt hover:underline font-semibold"
                >
                  Read Architecture Spec →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Skills Tracker: Designed Empty State per Brief -->
    <section class="space-y-4 pt-4 border-t border-hairline">
      <SectionHeader
        kicker="Capability Matrix"
        title="Owner Skills &amp; Competencies Tracker"
      />

      <div class="bg-surface border border-dashed border-hairline rounded-md p-8 text-center flex flex-col items-center justify-center">
        <div class="w-10 h-10 rounded-full bg-paper border border-hairline flex items-center justify-center font-mono text-sm text-muted mb-3">
          ⚡
        </div>
        <h4 class="font-serif text-base font-bold text-ink mb-1">
          Skills Tracker Awaiting Owner Milestone Inputs
        </h4>
        <p class="text-xs text-muted max-w-md font-sans leading-relaxed mb-3">
          This panel is pre-configured to automatically tally proficiency levels as the owner tags new engineering lab entries and deploys production experiments.
        </p>
        <span class="font-mono text-[11px] text-cobalt">
          Active Stack: Astro 5 · React · TypeScript · Tailwind CSS v4 · MiniSearch
        </span>
      </div>
    </section>

    <!-- Timeline: Designed Empty State per Brief -->
    <section class="space-y-4 pt-4 border-t border-hairline">
      <SectionHeader
        kicker="Milestone History"
        title="Chronological Engineering Timeline"
      />

      <div class="bg-surface border border-dashed border-hairline rounded-md p-8 text-center flex flex-col items-center justify-center">
        <div class="w-10 h-10 rounded-full bg-paper border border-hairline flex items-center justify-center font-mono text-sm text-muted mb-3">
          ◷
        </div>
        <h4 class="font-serif text-base font-bold text-ink mb-1">
          Timeline Awaiting Additional Lab Entries
        </h4>
        <p class="text-xs text-muted max-w-md font-sans leading-relaxed">
          Chronological progress snapshots will render dynamically as you create new Markdown entries in <code class="font-mono text-xs text-cobalt">src/data/lab/</code>.
        </p>
      </div>
    </section>
  </div>
</Layout>
