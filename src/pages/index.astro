---
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config/site';
import { url, formatDate } from '@/lib/url';
import {
  getRecentNews,
  getFeaturedNews,
  getFeaturedIndustries,
  getIndustries,
  getFeaturedCompanies,
  getLatestPulseEdition,
  getJobsPostedOnDate,
  getJobs,
  getDegrees,
  getRoles,
  getSkills,
  getTopSkillsFromJobs,
} from '@/services';
import { getNewsImpactTrail } from '@/lib/graph';

import SectionHeader from '@/components/ui/SectionHeader.astro';
import Tag from '@/components/ui/Tag.astro';
import CountryBadge from '@/components/ui/CountryBadge.astro';
import CompanyMonogram from '@/components/ui/CompanyMonogram.astro';
import DemoBadge from '@/components/ui/DemoBadge.astro';
import ImpactTrail from '@/components/ui/ImpactTrail.astro';
import Sparkline from '@/components/ui/Sparkline.astro';
import EuropeTileMap from '@/components/ui/EuropeTileMap.astro';
import PathExplorer from '@/components/islands/PathExplorer';

const [
  allNews,
  featuredNews,
  pulse,
  featuredIndustries,
  allIndustries,
  featuredCompanies,
  jobsToday,
  allJobs,
  allDegrees,
  allRoles,
  allSkills,
  topSkills,
] = await Promise.all([
  getRecentNews(6),
  getFeaturedNews(),
  getLatestPulseEdition(),
  getFeaturedIndustries(),
  getIndustries(),
  getFeaturedCompanies(),
  getJobsPostedOnDate('2026-09-29'),
  getJobs(),
  getDegrees(),
  getRoles(),
  getSkills(),
  getTopSkillsFromJobs(8),
]);

const leadStory = featuredNews[0] || allNews[0];
const leadTrail = leadStory ? await getNewsImpactTrail(leadStory) : null;
const otherStories = allNews.filter((n) => n.id !== leadStory?.id).slice(0, 4);

// JSON-LD structured data for homepage
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  headline: siteConfig.tagline,
  url: siteConfig.url,
  description: siteConfig.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteConfig.url}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="Europe's Business News, Connected to Your Career"
  description={siteConfig.description}
  jsonLd={websiteJsonLd}
>
  {/* Compact Hero (not full-screen, broadsheet precision) */}
  <section class="border-b border-hairline bg-surface py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Headline & Value Prop -->
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded border border-hairline bg-paper text-ink font-mono text-[11px] font-semibold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-amber live-pulse-dot" />
            <span>Pan-European Intelligence · 29 September 2026</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink leading-[1.15]">
            Europe's business news, <br class="hidden sm:inline" />
            <span class="text-cobalt">connected to your career.</span>
          </h1>

          <p class="font-sans text-base sm:text-lg text-muted max-w-2xl leading-relaxed">
            The only intelligence platform mapping industrial investments, policy directives, and technology shifts across France, Germany, the Netherlands, Italy, and Sweden directly to roles, skills, and open jobs.
          </p>

          <!-- Interactive Search & Example Queries -->
          <div class="pt-2 space-y-2">
            <div class="flex flex-wrap items-center gap-1.5 text-xs font-mono text-muted">
              <span class="font-semibold uppercase tracking-wider text-[10px]">Jump directly:</span>
              <a href={url('/jobs/?industry=robotics&country=france')} class="px-2 py-1 rounded bg-paper border border-hairline text-ink hover:border-cobalt transition-colors">
                Robotics in France →
              </a>
              <a href={url('/jobs/?degree=mim')} class="px-2 py-1 rounded bg-paper border border-hairline text-ink hover:border-cobalt transition-colors">
                MIM Graduate Roles →
              </a>
              <a href={url('/industries/semiconductors/')} class="px-2 py-1 rounded bg-paper border border-hairline text-ink hover:border-cobalt transition-colors">
                Semiconductors →
              </a>
              <a href={url('/jobs/?employmentType=Graduate+Programme')} class="px-2 py-1 rounded bg-paper border border-hairline text-ink hover:border-cobalt transition-colors">
                Graduate Programmes →
              </a>
            </div>
          </div>
        </div>

        <!-- Today's Pulse Hero Card -->
        <div class="lg:col-span-4">
          <aside class="bg-paper border border-hairline rounded-md p-5 text-ink space-y-4 relative overflow-hidden">
            <div class="flex items-center justify-between border-b border-hairline pb-2.5">
              <div class="flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wider text-ink">
                <span class="w-2 h-2 rounded-full bg-amber live-pulse-dot" />
                <span>Today's Pulse</span>
              </div>
              <span class="font-mono text-[11px] text-muted tabular-nums">
                Edition #{pulse.editionNumber}
              </span>
            </div>

            <p class="font-serif text-sm italic text-ink leading-relaxed">
              "{pulse.leadSummary}"
            </p>

            <div class="space-y-2 pt-1 border-t border-hairline text-xs font-mono">
              <div class="flex items-center justify-between">
                <span class="text-muted">Country Briefs:</span>
                <span class="font-semibold text-ink">FR · DE · NL · IT · SE</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-muted">Hiring Today:</span>
                <span class="font-semibold text-cobalt tabular-nums">{jobsToday.length} verified listings</span>
              </div>
            </div>

            <a
              href={url(`/pulse/${pulse.date}/`)}
              class="block w-full py-2 text-center rounded bg-ink text-surface hover:bg-cobalt transition-colors font-mono text-xs uppercase tracking-wider font-semibold"
            >
              Read Full Briefing →
            </a>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- Connected European Job Portals Multi-Portal Quick Search Launcher -->
  <section class="border-b border-hairline bg-paper py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-hairline">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-ink">
            Pan-European Employment Network · Continental Job Portals &amp; Top 250 Careers
          </h2>
        </div>
        <div class="flex items-center gap-3">
          <span class="font-mono text-xs text-cobalt font-bold tabular-nums">
            {allJobs.length} Live Vacancies In Database
          </span>
          <a
            href={url('/companies/')}
            class="text-xs font-mono bg-cobalt text-paper px-3 py-1 rounded hover:opacity-90 transition-opacity font-semibold"
          >
            Top 250 Corporate Careers →
          </a>
        </div>
      </div>

      <p class="text-xs text-muted font-sans leading-relaxed max-w-4xl">
        Access comprehensive employment databases across all 27 European Union member states and direct career portals of Europe's <strong>Top 250 largest enterprises</strong>. Search our <strong>{allJobs.length} verified listings</strong> or launch direct queries across Europe's leading platforms:
      </p>

      <!-- Pan-European Major Portals -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <!-- EURES (European Commission) -->
        <a
          href="https://eures.europa.eu/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded bg-surface border border-hairline hover:border-cobalt transition-colors group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-base select-none">🇪🇺</span>
              <span class="text-muted group-hover:text-cobalt text-[10px] font-mono">Official EU ↗</span>
            </div>
            <div class="font-serif font-bold text-xs text-ink group-hover:text-cobalt">
              EURES
            </div>
            <div class="text-[10px] text-muted font-sans line-clamp-1 mt-0.5">
              All 27 EU Member States
            </div>
          </div>
          <div class="mt-2 text-[10px] font-mono text-cobalt font-semibold">
            3M+ EU Jobs →
          </div>
        </a>

        <!-- Eurojobs -->
        <a
          href="https://www.eurojobs.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded bg-surface border border-hairline hover:border-cobalt transition-colors group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-base select-none">🌐</span>
              <span class="text-muted group-hover:text-cobalt text-[10px] font-mono">Pan-EU ↗</span>
            </div>
            <div class="font-serif font-bold text-xs text-ink group-hover:text-cobalt">
              Eurojobs
            </div>
            <div class="text-[10px] text-muted font-sans line-clamp-1 mt-0.5">
              Continental Multi-Country
            </div>
          </div>
          <div class="mt-2 text-[10px] font-mono text-cobalt font-semibold">
            Search Portal →
          </div>
        </a>

        <!-- LinkedIn Europe -->
        <a
          href="https://www.linkedin.com/jobs/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded bg-surface border border-hairline hover:border-cobalt transition-colors group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-base select-none">💼</span>
              <span class="text-muted group-hover:text-cobalt text-[10px] font-mono">Global ↗</span>
            </div>
            <div class="font-serif font-bold text-xs text-ink group-hover:text-cobalt">
              LinkedIn Europe
            </div>
            <div class="text-[10px] text-muted font-sans line-clamp-1 mt-0.5">
              Multinational Roles
            </div>
          </div>
          <div class="mt-2 text-[10px] font-mono text-cobalt font-semibold">
            Search Portal →
          </div>
        </a>

        <!-- StepStone Europe -->
        <a
          href="https://www.stepstone.de/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded bg-surface border border-hairline hover:border-cobalt transition-colors group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-base select-none">🇩🇪</span>
              <span class="text-muted group-hover:text-cobalt text-[10px] font-mono">Central EU ↗</span>
            </div>
            <div class="font-serif font-bold text-xs text-ink group-hover:text-cobalt">
              StepStone
            </div>
            <div class="text-[10px] text-muted font-sans line-clamp-1 mt-0.5">
              Germany &amp; Central Europe
            </div>
          </div>
          <div class="mt-2 text-[10px] font-mono text-cobalt font-semibold">
            Search Portal →
          </div>
        </a>

        <!-- Welcome to the Jungle Europe -->
        <a
          href="https://www.welcometothejungle.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded bg-surface border border-hairline hover:border-cobalt transition-colors group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-base select-none">🌴</span>
              <span class="text-muted group-hover:text-cobalt text-[10px] font-mono">Tech &amp; AI ↗</span>
            </div>
            <div class="font-serif font-bold text-xs text-ink group-hover:text-cobalt">
              Welcome to the Jungle
            </div>
            <div class="text-[10px] text-muted font-sans line-clamp-1 mt-0.5">
              Paris, Berlin, London, Madrid
            </div>
          </div>
          <div class="mt-2 text-[10px] font-mono text-cobalt font-semibold">
            Search Portal →
          </div>
        </a>

        <!-- Indeed Europe -->
        <a
          href="https://www.indeed.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded bg-surface border border-hairline hover:border-cobalt transition-colors group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-base select-none">🔍</span>
              <span class="text-muted group-hover:text-cobalt text-[10px] font-mono">Aggregator ↗</span>
            </div>
            <div class="font-serif font-bold text-xs text-ink group-hover:text-cobalt">
              Indeed Europe
            </div>
            <div class="text-[10px] text-muted font-sans line-clamp-1 mt-0.5">
              Cross-Border Search
            </div>
          </div>
          <div class="mt-2 text-[10px] font-mono text-cobalt font-semibold">
            Search Portal →
          </div>
        </a>
      </div>

      <!-- Top 250 Corporate Direct Career Banner -->
      <div class="p-4 rounded-lg bg-surface border border-cobalt/40 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-cobalt bg-cobalt/10 px-2 py-0.5 rounded">
              Direct Enterprise Hiring Network
            </span>
            <span class="font-mono text-xs text-muted">250 Companies Connected</span>
          </div>
          <p class="font-serif text-sm font-bold text-ink">
            Direct Corporate Career Portals of Europe's Top 250 Employers
          </p>
          <p class="text-xs text-muted font-sans max-w-3xl">
            Bypass third-party boards. Apply directly on verified careers sites and graduate programs for <strong>BMW, Airbus, ASML, Novo Nordisk, SAP, LVMH, Roche, Siemens, Spotify, Schneider Electric, Ferrari</strong>, and 239 more across 16 European nations.
          </p>
        </div>
        <div class="shrink-0 flex items-center gap-3">
          <a
            href={url('/companies/')}
            class="px-4 py-2 rounded bg-cobalt text-paper font-mono text-xs font-semibold hover:opacity-90 transition-opacity inline-flex items-center gap-1.5"
          >
            <span>Open Top 250 Directory</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Europe Business Pulse Condensed Briefing -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-hairline">
    <SectionHeader
      kicker="Daily Intelligence"
      title="Europe Business Pulse"
      description="Executive multi-country roundup for France, Germany, the Netherlands, Italy, and Sweden."
      actionText="Open Full Edition"
      actionHref={`/pulse/${pulse.date}/`}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
      {
        pulse.countryBriefs.map((cb) => (
          <div class="bg-surface border border-hairline rounded-md p-4 flex flex-col justify-between hover:border-cobalt transition-colors">
            <div>
              <div class="flex items-center justify-between mb-2 pb-2 border-b border-hairline">
                <CountryBadge iso2={cb.countryIso2} slug={cb.countrySlug} name={cb.countryName} size="sm" />
                <span class="font-mono text-[10px] text-muted uppercase">Brief</span>
              </div>
              <ul class="space-y-2 text-xs font-sans text-ink/90">
                {cb.items.slice(0, 2).map((item) => (
                  <li class="leading-snug">
                    <span class="font-mono text-[10px] text-cobalt uppercase mr-1">
                      [{item.industryName.slice(0, 4)}]
                    </span>
                    {item.text}
                  </li>
                ))}
              </ul>
            </div>
            <div class="mt-3 pt-2 border-t border-hairline text-right">
              <a
                href={url(`/countries/${cb.countrySlug}/`)}
                class="font-mono text-[11px] text-cobalt hover:underline font-semibold"
              >
                {cb.countryName} Hub →
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Top Stories: Asymmetric Layout (One Lead + Editorial List) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-hairline">
    <SectionHeader
      kicker="Editorial Dispatches"
      title="Top Stories & Career Impact"
      description="Every European business development analyzed for its downstream impact on skills, roles, and hiring."
      actionText="View All Dispatches"
      actionHref="/news/"
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Lead Story (7 cols) with Rich Career Impact Trail -->
      {leadStory && (
        <article class="lg:col-span-7 bg-surface border border-hairline rounded-md p-6 space-y-4 hover:border-cobalt transition-colors">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs text-muted tabular-nums">{formatDate(leadStory.date)}</span>
            <span class="text-hairline select-none">·</span>
            <span class="font-mono text-xs text-cobalt font-semibold">{leadStory.source.name}</span>
            <DemoBadge type="news" />
          </div>

          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-ink leading-tight">
            <a href={url(`/news/${leadStory.slug}/`)} class="hover:text-cobalt hover:underline">
              {leadStory.title}
            </a>
          </h3>

          <p class="font-sans text-base text-ink/80 leading-relaxed">
            {leadStory.summary}
          </p>

          <!-- Career Impact Box -->
          <div class="bg-paper border-l-2 border-amber p-4 rounded-r text-sm text-ink font-sans italic leading-relaxed">
            <strong class="font-mono text-xs uppercase font-bold not-italic text-amber block mb-1">
              What this means for careers:
            </strong>
            "{leadStory.careerImpact}"
          </div>

          <!-- Trail Chips on Lead Card -->
          {leadTrail && (
            <div class="pt-2">
              <ImpactTrail trail={leadTrail} compact={true} />
            </div>
          )}
        </article>
      )}

      <!-- Editorial List of Other Top Stories (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        {otherStories.map((story) => (
          <article class="bg-surface border border-hairline rounded-md p-4 hover:border-cobalt transition-colors group">
            <div class="flex items-center gap-2 font-mono text-[11px] text-muted mb-1 tabular-nums">
              <span>{formatDate(story.date)}</span>
              <span>·</span>
              <span class="text-cobalt font-semibold">{story.industries[0]?.toUpperCase()}</span>
            </div>
            <h4 class="font-serif text-base font-bold text-ink group-hover:text-cobalt transition-colors leading-snug mb-1.5">
              <a href={url(`/news/${story.slug}/`)} class="hover:underline">
                {story.title}
              </a>
            </h4>
            <p class="text-xs text-muted font-sans line-clamp-2 leading-relaxed">
              {story.careerImpact}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry Trends: Small Multiples with SVG Sparklines -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-hairline">
    <SectionHeader
      kicker="Momentum Series"
      title="Industry Trends & Momentum"
      description="7-point activity series derived across European patent filings, investments, and hiring requisitions."
      actionText="Explore 14 Industries"
      actionHref="/industries/"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        featuredIndustries.map((ind) => (
          <a
            href={url(`/industries/${ind.slug}/`)}
            class="bg-surface border border-hairline rounded-md p-4 hover:border-cobalt transition-colors flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <Tag label={ind.name} color={ind.color} />
                <span class="font-mono text-xs text-muted uppercase">Momentum</span>
              </div>
              <p class="text-xs text-muted font-sans line-clamp-2 mb-3">
                {ind.summary}
              </p>
            </div>

            <div class="flex items-center justify-between pt-2 border-t border-hairline">
              <span class="font-mono text-[10px] text-muted uppercase">Trend Trajectory</span>
              <Sparkline data={ind.momentumSeries} width={100} height={24} />
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Country Activity: Europe Tile Map -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-hairline">
    <SectionHeader
      kicker="Geographical Intelligence"
      title="Europe Activity & Student Gateways"
      description="Geographic placement of the 14 European single-market economies with visa notes and direct job pipelines."
      actionText="All Country Hubs"
      actionHref="/countries/"
    />

    <EuropeTileMap />
  </section>

  <!-- Companies to Watch: Monogram Directory Cards -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-hairline">
    <SectionHeader
      kicker="Anchor Employers"
      title="Companies to Watch"
      description="Public corporate profiles across aerospace, automotive, semiconductors, robotics, and luxury."
      actionText="Company Directory"
      actionHref="/companies/"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        featuredCompanies.map((comp) => {
          const compJobs = allJobs.filter((j) => j.company.toLowerCase() === comp.slug.toLowerCase());
          return (
            <a
              href={url(`/companies/${comp.slug}/`)}
              class="bg-surface border border-hairline rounded-md p-5 hover:border-cobalt transition-colors group flex flex-col justify-between"
            >
              <div>
                <div class="flex items-start justify-between gap-3 mb-3">
                  <div class="flex items-center gap-3">
                    <CompanyMonogram name={comp.name} size="md" />
                    <div>
                      <h3 class="font-serif text-lg font-bold text-ink group-hover:text-cobalt transition-colors leading-tight">
                        {comp.name}
                      </h3>
                      <div class="font-mono text-[11px] text-muted">
                        HQ: {comp.hqCity} · Founded {comp.founded}
                      </div>
                    </div>
                  </div>
                  <CountryBadge iso2={comp.country.slice(0, 2).toUpperCase()} slug={comp.country} size="sm" linkable={false} />
                </div>

                <p class="text-xs text-ink/80 font-sans line-clamp-2 mb-3 leading-relaxed">
                  {comp.summary}
                </p>
              </div>

              <div class="flex items-center justify-between pt-3 border-t border-hairline text-xs font-mono">
                <span class="text-muted">Open Roles:</span>
                <span class="font-semibold text-cobalt tabular-nums">{compJobs.length} active listings</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- Jobs Posted Today: Live Hiring Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-hairline">
    <SectionHeader
      kicker="Daily Intake"
      title="Jobs Posted Today (29 September 2026)"
      description="Active graduate schemes, working student placements, apprenticeships, and entry engineering opportunities."
      actionText="Open Jobs Explorer"
      actionHref="/jobs/"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        jobsToday.slice(0, 6).map((job) => (
          <article class="bg-surface border border-hairline rounded-md p-4 hover:border-cobalt transition-colors group">
            <div class="flex items-center justify-between gap-2 mb-2 font-mono text-[11px]">
              <div class="flex items-center gap-1.5 text-muted">
                <span class="font-bold text-ink uppercase">{job.company}</span>
                <span>·</span>
                <span>[{job.country.slice(0, 2).toUpperCase()}] {job.city}</span>
              </div>
              <span class="px-2 py-0.5 rounded bg-paper border border-hairline text-ink font-semibold">
                {job.employmentType}
              </span>
            </div>

            <h4 class="font-serif text-base font-bold text-ink group-hover:text-cobalt transition-colors mb-2">
              <a href={url(`/jobs/${job.slug}/`)} class="hover:underline">
                {job.title}
              </a>
            </h4>

            <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-hairline text-xs font-mono">
              <div class="flex items-center gap-1">
                {job.degrees.slice(0, 2).map((d) => (
                  <span class="text-[10px] px-1 py-0.5 rounded bg-cobalt/5 text-cobalt border border-cobalt/20">
                    {d.toUpperCase()}
                  </span>
                ))}
              </div>
              <a href={url(`/jobs/${job.slug}/`)} class="text-cobalt hover:underline font-semibold">
                View Listing →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Career Hub Path Explorer Preview -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-hairline">
    <SectionHeader
      kicker="Interactive Pathways"
      title="Career Hub Path Explorer"
      description="Pick your academic qualification to map out skills, roles, target industries, and hiring employers."
      actionText="Full Career Hub"
      actionHref="/careers/"
    />

    <PathExplorer
      client:visible
      degrees={allDegrees}
      skills={allSkills}
      roles={allRoles}
      industries={allIndustries}
      companies={featuredCompanies}
      jobs={allJobs}
      initialDegreeSlug="mim"
    />
  </section>

  <!-- Skills Spotlight: Computed from Jobs Data -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <SectionHeader
      kicker="Market Signals"
      title="Top In-Demand Skills in Europe"
      description="Live skill frequency computed directly from active job requisitions across Europe."
      actionText="Search by Skill"
      actionHref="/jobs/"
    />

    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
      {
        topSkills.map(({ skill, count }) => (
          <a
            href={url(`/jobs/?query=${encodeURIComponent(skill.name)}`)}
            class="bg-surface border border-hairline rounded-md p-3 text-center hover:border-cobalt transition-colors group flex flex-col justify-between"
          >
            <div class="font-mono text-xl font-bold text-cobalt tabular-nums mb-1">
              {count}
            </div>
            <div>
              <div class="text-xs font-medium text-ink group-hover:text-cobalt leading-tight truncate">
                {skill.name}
              </div>
              <div class="text-[10px] font-mono text-muted uppercase mt-0.5">
                {skill.category.slice(0, 8)}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
