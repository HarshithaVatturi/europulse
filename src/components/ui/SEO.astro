---
import { siteConfig } from '@/config/site';
import { url } from '@/lib/url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishDate?: string;
  jsonLd?: Record<string, any>;
}

const {
  title,
  description = siteConfig.description,
  ogImage = '/og-image.svg',
  noindex = false,
  type = 'website',
  publishDate,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} — ${siteConfig.name}` : `${siteConfig.name} — ${siteConfig.tagline}`;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const fullOgImageUrl = new URL(url(ogImage), siteConfig.url).href;
---

<!-- Page Meta -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImageUrl} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content="en_GB" />
{publishDate && <meta property="article:published_time" content={publishDate} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImageUrl} />

<!-- Structured Data JSON-LD -->
{
  jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )
}
