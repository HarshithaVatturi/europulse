---
import { url } from '@/lib/url';
import type { NewsImpactTrail } from '@/lib/graph';
import CompanyMonogram from './CompanyMonogram.astro';
import CountryBadge from './CountryBadge.astro';

interface Props {
  trail: NewsImpactTrail;
  compact?: boolean;
  class?: string;
}

const { trail, compact = false, class: className = '' } = Astro.props;
const { news, companies, industries, countries, skills, roles, relatedJobs } = trail;

const primaryCompany = companies[0];
const primaryIndustry = industries[0];
const primaryCountry = countries[0];
---

{
  compact ? (
    <div class={`flex flex-wrap items-center gap-1.5 text-xs ${className}`}>
      <span class="font-mono text-[10px] uppercase font-bold tracking-wider text-muted select-none">
        Trail:
      </span>

      {primaryCompany && (
        <a
          href={url(`/companies/${primaryCompany.slug}/`)}
          class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded border border-hairline bg-surface text-ink hover:border-cobalt hover:text-cobalt transition-colors font-sans"
        >
          <span class="font-mono font-bold text-[10px] text-muted">Co:</span>
          <span>{primaryCompany.name}</span>
        </a>
      )}

      {primaryIndustry && (
        <>
          <span class="text-hairline select-none">→</span>
          <a
            href={url(`/industries/${primaryIndustry.slug}/`)}
            class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded border border-hairline bg-surface text-ink hover:border-cobalt hover:text-cobalt transition-colors font-sans"
          >
            <span
              class="w-1.5 h-1.5 rounded-full"
              style={`background-color: ${primaryIndustry.color};`}
            />
            <span>{primaryIndustry.name}</span>
          </a>
        </>
      )}

      {primaryCountry && (
        <>
          <span class="text-hairline select-none">→</span>
          <CountryBadge iso2={primaryCountry.iso2} slug={primaryCountry.slug} size="sm" />
        </>
      )}

      {skills.length > 0 && (
        <>
          <span class="text-hairline select-none">→</span>
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded border border-hairline bg-surface text-muted text-[11px] font-mono">
            {skills[0].name}
          </span>
        </>
      )}

      {roles.length > 0 && (
        <>
          <span class="text-hairline select-none">→</span>
          <a
            href={url(`/careers/roles/${roles[0].slug}/`)}
            class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded border border-hairline bg-surface text-ink hover:border-cobalt hover:text-cobalt transition-colors text-[11px] font-mono"
          >
            {roles[0].name}
          </a>
        </>
      )}

      {relatedJobs.length > 0 && (
        <>
          <span class="text-hairline select-none">→</span>
          <a
            href={url(`/jobs/?industry=${primaryIndustry?.slug || ''}&country=${primaryCountry?.slug || ''}`)}
            class="inline-flex items-center gap-1 px-2 py-0.5 rounded border border-cobalt bg-cobalt/10 text-cobalt hover:bg-cobalt hover:text-white transition-colors text-[11px] font-mono font-semibold"
          >
            <span>{relatedJobs.length} Jobs</span>
          </a>
        </>
      )}
    </div>
  ) : (
    <section class={`bg-surface border border-hairline rounded-md p-6 ${className}`}>
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-full bg-amber live-pulse-dot" />
        <h3 class="font-mono text-xs font-bold uppercase tracking-widest text-cobalt">
          What this means for careers
        </h3>
      </div>

      <p class="font-serif text-lg leading-relaxed text-ink mb-6 italic border-l-2 border-amber pl-4 py-1">
        "{news.careerImpact}"
      </p>

      {/* Sequential Pipeline Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 mb-6 relative">
        <!-- Step 1: Company -->
        <div class="bg-paper border border-hairline rounded p-3 flex flex-col justify-between">
          <span class="font-mono text-[10px] uppercase font-bold tracking-wider text-muted mb-1">
            1. Company
          </span>
          {primaryCompany ? (
            <a
              href={url(`/companies/${primaryCompany.slug}/`)}
              class="group flex items-center gap-2 mt-1"
            >
              <CompanyMonogram name={primaryCompany.name} size="sm" />
              <span class="text-xs font-semibold text-ink group-hover:text-cobalt transition-colors truncate">
                {primaryCompany.name}
              </span>
            </a>
          ) : (
            <span class="text-xs text-muted">Sector-wide</span>
          )}
        </div>

        <!-- Step 2: Industry -->
        <div class="bg-paper border border-hairline rounded p-3 flex flex-col justify-between">
          <span class="font-mono text-[10px] uppercase font-bold tracking-wider text-muted mb-1">
            2. Industry
          </span>
          {primaryIndustry ? (
            <a
              href={url(`/industries/${primaryIndustry.slug}/`)}
              class="group flex items-center gap-1.5 mt-1"
            >
              <span
                class="w-2 h-2 rounded-full shrink-0"
                style={`background-color: ${primaryIndustry.color};`}
              />
              <span class="text-xs font-semibold text-ink group-hover:text-cobalt transition-colors truncate">
                {primaryIndustry.name}
              </span>
            </a>
          ) : (
            <span class="text-xs text-muted">Cross-industry</span>
          )}
        </div>

        <!-- Step 3: Country -->
        <div class="bg-paper border border-hairline rounded p-3 flex flex-col justify-between">
          <span class="font-mono text-[10px] uppercase font-bold tracking-wider text-muted mb-1">
            3. Geography
          </span>
          <div class="flex flex-wrap gap-1 mt-1">
            {countries.map((c) => (
              <CountryBadge iso2={c.iso2} slug={c.slug} name={c.name} size="sm" />
            ))}
          </div>
        </div>

        <!-- Step 4: Skills Required -->
        <div class="bg-paper border border-hairline rounded p-3 flex flex-col justify-between">
          <span class="font-mono text-[10px] uppercase font-bold tracking-wider text-muted mb-1">
            4. In-Demand Skills
          </span>
          <div class="flex flex-wrap gap-1 mt-1">
            {skills.slice(0, 2).map((s) => (
              <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-surface border border-hairline text-ink">
                {s.name}
              </span>
            ))}
          </div>
        </div>

        <!-- Step 5: Target Roles -->
        <div class="bg-paper border border-hairline rounded p-3 flex flex-col justify-between">
          <span class="font-mono text-[10px] uppercase font-bold tracking-wider text-muted mb-1">
            5. Target Roles
          </span>
          <div class="flex flex-col gap-1 mt-1">
            {roles.slice(0, 2).map((r) => (
              <a
                href={url(`/careers/roles/${r.slug}/`)}
                class="text-xs font-medium text-ink hover:text-cobalt transition-colors truncate"
              >
                {r.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Step 6: Matching Jobs -->
        <div class="bg-cobalt/5 border border-cobalt/30 rounded p-3 flex flex-col justify-between">
          <span class="font-mono text-[10px] uppercase font-bold tracking-wider text-cobalt mb-1">
            6. Live Roles
          </span>
          <div class="mt-1">
            <span class="font-mono text-xl font-bold text-cobalt tabular-nums">
              {relatedJobs.length}
            </span>
            <span class="text-xs text-muted ml-1">open</span>
          </div>
        </div>
      </div>

      <!-- Action link to matched jobs -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-hairline">
        <span class="text-xs text-muted font-sans">
          Graph relationships derived automatically from company, sector and geographical signals.
        </span>

        {relatedJobs.length > 0 && (
          <a
            href={url(
              primaryCompany
                ? `/jobs/?company=${primaryCompany.slug}`
                : `/jobs/?industry=${primaryIndustry?.slug || ''}`
            )}
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded border border-cobalt bg-cobalt text-white hover:bg-cobalt/90 transition-colors text-xs font-mono font-semibold uppercase tracking-wider"
          >
            <span>Explore {relatedJobs.length} Matching Jobs</span>
            <span>→</span>
          </a>
        )}
      </div>
    </section>
  )
}
