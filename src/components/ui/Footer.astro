---
import { siteConfig, isOwnerPopulated } from '@/config/site';
import { url } from '@/lib/url';

const hasOwner = isOwnerPopulated();
const owner = siteConfig.owner;
---

<footer class="bg-surface border-t border-hairline mt-auto text-ink font-sans transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <!-- Col 1: Wordmark & Purpose -->
      <div class="lg:col-span-2 space-y-3">
        <a href={url('/')} class="flex items-center gap-1 group select-none">
          <span class="font-serif text-2xl font-bold tracking-tight text-ink group-hover:text-cobalt transition-colors">
            {siteConfig.name}
          </span>
          <span class="w-2 h-2 rounded-full bg-amber inline-block live-pulse-dot -mt-2" aria-hidden="true" />
        </a>
        <p class="text-xs text-muted max-w-sm font-sans leading-relaxed">
          {siteConfig.description}
        </p>

        <div class="pt-2 text-[11px] font-mono text-muted space-y-1">
          <div>PULSE DATE: 29 September 2026</div>
          <div>HOSTED: GitHub Pages (Static HTML)</div>
          <div>PRIVACY: No Cookies · No Trackers · Self-Hosted Fonts</div>
        </div>

        {/* Owner profile link if populated */}
        {hasOwner && (
          <div class="pt-2 text-xs font-mono text-muted">
            Curated &amp; Developed by <span class="text-ink font-semibold">{owner.name}</span>
            {owner.role && <span> · {owner.role}</span>}
          </div>
        )}
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-muted mb-3">
          Platform
        </h4>
        <ul class="space-y-2 text-xs font-mono">
          <li><a href={url('/pulse/')} class="text-ink hover:text-cobalt">Europe Pulse</a></li>
          <li><a href={url('/news/')} class="text-ink hover:text-cobalt">News Dispatches</a></li>
          <li><a href={url('/industries/')} class="text-ink hover:text-cobalt">Industries</a></li>
          <li><a href={url('/countries/')} class="text-ink hover:text-cobalt">Countries</a></li>
          <li><a href={url('/companies/')} class="text-ink hover:text-cobalt">Companies</a></li>
          <li><a href={url('/jobs/')} class="text-ink hover:text-cobalt">Job Pipeline</a></li>
          <li><a href={url('/careers/')} class="text-ink hover:text-cobalt">Career Hub</a></li>
        </ul>
      </div>

      <!-- Col 3: Research & Methodology -->
      <div>
        <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-muted mb-3">
          Governance
        </h4>
        <ul class="space-y-2 text-xs font-mono">
          <li><a href={url('/about/')} class="text-ink hover:text-cobalt">About EuroPulse</a></li>
          <li><a href={url('/about/#methodology')} class="text-ink hover:text-cobalt">Graph Architecture</a></li>
          <li><a href={url('/about/#ethics')} class="text-ink hover:text-cobalt">Data Ethics &amp; Sources</a></li>
          <li><a href={url('/my-lab/')} class="text-ink hover:text-cobalt">My Lab Dashboard</a></li>
          <li><a href={url('/search/')} class="text-ink hover:text-cobalt">Global Search (⌘K)</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter in Honest Launching Soon state -->
      <div>
        <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-muted mb-3">
          Briefing Dispatch
        </h4>
        <p class="text-xs text-muted mb-3 leading-relaxed">
          Daily European business headlines connected directly to hiring signals.
        </p>
        <form id="newsletter-form" class="space-y-2" data-webhook={siteConfig.newsletter?.webhookUrl || ''}>
          <input
            id="newsletter-email"
            type="email"
            required
            placeholder="colleague@domain.eu"
            class="w-full text-xs bg-paper border border-hairline rounded p-2 text-ink placeholder:text-muted focus:border-cobalt outline-none font-sans"
            aria-label="Email address for dispatch"
          />
          <button
            type="submit"
            class="w-full py-1.5 px-3 rounded bg-ink text-surface hover:bg-cobalt text-xs font-mono uppercase tracking-wider font-semibold transition-colors"
          >
            Subscribe
          </button>
        </form>
        <div id="newsletter-msg" class="hidden text-[11px] font-mono text-trend-up mt-1">
          ✓ Note: Newsletter distribution is launching soon. No personal data stored.
        </div>
        <script is:inline>
          const form = document.getElementById('newsletter-form');
          const msg = document.getElementById('newsletter-msg');
          form?.addEventListener('submit', async function(e) {
            e.preventDefault();
            const webhook = form.getAttribute('data-webhook');
            const emailInput = document.getElementById('newsletter-email');
            const email = emailInput ? emailInput.value : '';

            if (webhook) {
              try {
                await fetch(webhook, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ email, timestamp: new Date().toISOString() })
                });
                if (msg) {
                  msg.textContent = '✓ Subscribed successfully! European dispatches incoming.';
                  msg.classList.remove('hidden');
                }
              } catch (err) {
                if (msg) {
                  msg.textContent = '✓ Registered interest locally. Thank you!';
                  msg.classList.remove('hidden');
                }
              }
            } else {
              if (msg) msg.classList.remove('hidden');
            }
          });
        </script>
      </div>
    </div>

    <!-- Bottom hairline separator & copyright -->
    <div class="pt-8 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-muted">
      <div>
        © 2026 {siteConfig.name} · Copyright © 2026 <span class="text-ink font-semibold">Ghowarthan Karunanidhi</span>. All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <a href={url('/about/#ethics')} class="hover:text-ink">Terms &amp; Ethics</a>
        <span>·</span>
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-ink">GitHub</a>
        <span>·</span>
        <a href={url('/sitemap-index.xml')} class="hover:text-ink">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
