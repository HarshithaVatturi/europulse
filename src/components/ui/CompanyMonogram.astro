---
interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { name, size = 'md', class: className = '' } = Astro.props;

// Generate 2-character monogram
function getMonogram(companyName: string): string {
  const clean = companyName.replace(/[^a-zA-Z0-9\s]/g, '').trim();
  const words = clean.split(/\s+/);
  if (words.length >= 2) {
    return (words[0][0] + words[1][0]).toUpperCase();
  }
  return clean.slice(0, 2).toUpperCase();
}

const initials = getMonogram(name);

const sizeStyles = {
  sm: 'w-6 h-6 text-[10px] rounded',
  md: 'w-8 h-8 text-xs rounded',
  lg: 'w-12 h-12 text-base rounded-md',
  xl: 'w-16 h-16 text-xl rounded-md',
};
---

<div
  class={`inline-flex items-center justify-center font-mono font-bold tracking-wider bg-surface border border-hairline text-ink shrink-0 select-none ${sizeStyles[size]} ${className}`}
  title={name}
  aria-hidden="true"
>
  {initials}
</div>
